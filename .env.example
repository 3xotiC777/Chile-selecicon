VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server only, encrypted variables in Vercel. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-key
CRON_SECRET=generate-a-random-secret-of-at-least-32-characters
SQLSERVER_HOST=your-sql-server
SQLSERVER_DATABASE=your-database
SQLSERVER_PORT=1433
SQLSERVER_USER=read-only-user
SQLSERVER_PASSWORD=your-server-password
# For a private certificate: trusted PEM certificate and its certified name.
SQLSERVER_CA_PEM=
SQLSERVER_CERT_NAME=
